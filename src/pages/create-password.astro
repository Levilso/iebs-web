---
export const prerender = false;

import { eq } from 'drizzle-orm';
import BaseLayout from '../layouts/BaseLayout.astro';
import { db } from '../db/client';
import { invitationTokens, users } from '../db/schema';
import { hashToken } from '../lib/auth';

const token = Astro.url.searchParams.get('token') ?? '';

let valid = false;
let userName = '';

if (token) {
    // Buscar el token en la base de datos y obtener la fecha de expiración y el nombre del usuario asociados
    const record = await db
        .select({ expiresAt: invitationTokens.expiresAt, name: users.name })
        .from(invitationTokens)
        .innerJoin(users, eq(invitationTokens.userId, users.id))
        .where(eq(invitationTokens.tokenHash, hashToken(token)))
        .get();

    // Verificar si el token existe y no ha expirado
    if (record && record.expiresAt > new Date()) {
        valid = true;
        userName = record.name;
    }
}

// Seguridad en la URL y en la caché
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Cache-Control', 'no-store');

if (!valid) Astro.response.status = 400;
---

<BaseLayout pageTitle="Crear contraseña">
    <div class="min-h-screen flex items-center justify-center">
        <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-sm">
            {valid ? (
                <>
                    <h1 class="text-2xl font-bold text-gray-800 mb-2 text-center">
                        Bienvenido/a, {userName}
                    </h1>
                    <p class="text-sm text-gray-500 mb-6 text-center">
                        Elige una contraseña para activar tu cuenta.
                    </p>

                    <div id="feedback" class="hidden mb-4 p-3 rounded text-sm font-medium" role="status"></div>

                    <form id="password-form" class="space-y-4">
                        
                        <input type="hidden" name="token" value={token} />

                        {/* nueva contraseña */}
                        <div>
                            <label for="password" class="block text-sm font-semibold text-gray-700 mb-1">
                                Contraseña (mínimo 8 caracteres)
                            </label>
                            <input type="password" id="password" name="password"
                                minlength="8" maxlength="128" autocomplete="new-password" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" />
                        </div>
                        <div>
                            <label for="confirm" class="block text-sm font-semibold text-gray-700 mb-1">
                                Repite la contraseña
                            </label>
                            <input type="password" id="confirm" autocomplete="new-password" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" />
                        </div>

                        <button type="submit" id="btn-submit"
                            class="w-full py-2 px-4 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors cursor-pointer">
                            Activar cuenta
                        </button>
                    </form>
                </>
            ) : (
                <>
                    <h1 class="text-2xl font-bold text-gray-800 mb-4 text-center">Enlace no válido</h1>
                    <p class="text-gray-600 text-center">
                        Este enlace es inválido o ha caducado. Pide uno nuevo a la secretaría de la iglesia.
                    </p>
                </>
            )}
        </div>
    </div>
</BaseLayout>

<script>
    import { actions } from 'astro:actions';

    const form = document.getElementById('password-form') as HTMLFormElement | null;
    const feedback = document.getElementById('feedback') as HTMLDivElement | null;
    const btn = document.getElementById('btn-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!feedback || !btn) return;

        const formData = new FormData(form);
        const confirm = (document.getElementById('confirm') as HTMLInputElement).value;

        feedback.className = 'mb-4 p-3 rounded text-sm font-medium';
        if (formData.get('password') !== confirm) {
            feedback.classList.add('bg-red-100', 'text-red-700');
            feedback.textContent = 'Las contraseñas no coinciden.';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Activando...';

        const { data, error } = await actions.auth.setInitialPassword(formData);

        if (error) {
            feedback.classList.add('bg-red-100', 'text-red-700');
            feedback.textContent = error.message;
            btn.disabled = false;
            btn.textContent = 'Activar cuenta';
            return;
        }

        feedback.classList.add('bg-green-100', 'text-green-700');
        feedback.textContent = data.message;
        setTimeout(() => (window.location.href = '/'), 1200);
    })
</script>