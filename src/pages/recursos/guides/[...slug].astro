---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const guides = await getCollection('guides');
    return guides.map((guide) => ({
        params: { slug: guide.id },
        props: { guide },
    }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout pageTitle={guide.data.title}>
    <article class="max-w-3xl mx-auto px-6 py-12">
        <header class="mb-8 pb-6 border-b border-gray-200">
            <h1 class="text-4xl font-bold text-gray-900 mb-3">{guide.data.title}</h1>
 
            <div class="flex flex-col gap-1 text-sm text-gray-500">
                <p>📖 <strong>Pasaje:</strong> {guide.data.scripture}</p>
                <p>📅 {guide.data.pubDate.toLocaleDateString('es-ES', { dateStyle: 'long' })}</p>
            </div>
        </header>
 
        <div class="prose prose-gray max-w-none">
            <Content />
        </div>
    </article>
</BaseLayout>