---
import Welcome from '../components/ui/Welcome.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexBento from '../components/sections/IndexBento.astro';
import EventGallery from '../components/events/EventGallery.astro';
import EventsFilter from '../components/events/EventsFilter';
import Button from '../components/ui/Button.astro';

const pageTitle = "Iglesia Evangélica Bautista de Sevilla - Inicio";
---

<BaseLayout 
	pageTitle={pageTitle} 
	description=`Una iglesia en Sevilla que hace discípulos que hacen discípulos.
	Existimos para glorificar a Dios, expandir su Reino y hacer completamente Su voluntad.`
>
	<!-- hero de introducción -->
	<Welcome />

	<span class="h-6"/>

	<!-- presentación -->
	<section
	class="w-full max-w-160 h-auto lg:px-8 lg:max-w-400">
		
		<!-- bento -->
		<div
		class=" w-full p-4
				flex flex-col
				rounded-t-[40px] bg-brand">

			<IndexBento />
		</div>
		<!-- historia -->
		<div class="flex flex-col p-6 w-full h-90 lg:h-100 bg-right
					rounded-b-[40px] bg-[url(/cristalera-edit.jpg)] bg-cover
					">

			<div class="flex flex-col gap-4 items-end justify-center text-right text-white">
				<h1>Conoce nuestra <br> historia</h1>
				<Button bg="ivory" textColor="brand-dark">¿Quiénes somos?</Button>
			</div>
		</div>

	</section>
	

	<span class="block h-40"></span>
</BaseLayout>
