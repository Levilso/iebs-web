---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNav from '../components/ui/PageNav.astro';
import Intro from '../components/ui/Intro.astro';
import EventCard from '../components/events/EventCard.astro';

import { db, EventEntry } from 'astro:db';
import EventGallery from '../components/events/EventGallery.astro';

export const prerender = false
const dbEvents = await db.select().from(EventEntry);

const pageTitle = "Eventos"
---

<BaseLayout 
	pageTitle={pageTitle} 
	description=`Una iglesia en Sevilla que hace discípulos que hacen discípulos.
	Existimos para glorificar a Dios, expandir su Reino y hacer completamente Su voluntad.`
>

	<!-- todo esto es el "slot" -->
	<Intro h1={pageTitle} />
	<PageNav />
	
	<!-- sección de eventos -->
	 <EventGallery />

</BaseLayout>