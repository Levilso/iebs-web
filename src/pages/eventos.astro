---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/ui/Intro.astro';
import EventsFilter from '../components/events/EventsFilter.tsx';

import { db, eq, EventEntry } from 'astro:db';

const dbEvents = await db.select().from(EventEntry)
    .where(/* hidden = false */ eq(EventEntry.hidden, false));

// hay que serializar la fecha
const events = dbEvents.map(e => ({
    ...e,
    date: e.date.toISOString(),
}));

const pageTitle = "Próximos Eventos";
---

<BaseLayout
    pageTitle={pageTitle}
    description="Próximos eventos en la Iglesia Evangélica Bautista de Sevilla."
>
    <Intro h1="Events" />

    <section class="mx-20 py-10">
        <h2 class="font-semibold text-black text-3xl py-5 mx-12">Upcoming Events</h2>
        <div class="mx-12">
            <!--
                client:load → hydrates immediately on page load.
                The island receives events as a serialized prop.
            -->
            <EventsFilter events={events} client:load />
        </div>
    </section>
</BaseLayout>