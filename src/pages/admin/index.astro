---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro"
import EventTable from "../../components/events/EventTable.astro"
import UserTable from "../../components/admin/UserTable.astro"

---
<AdminLayout pageTitle="Panel de Administración">
    <div class="space-y-8">
        <section class="border-l-4 border-alternative bg-white p-6 shadow-sm">
            <div class="mb-5 flex items-center justify-between gap-4">
                <h2 class="text-2xl font-semibold text-gray-800">Eventos</h2>
                <a href="/admin/eventos" class="font-semibold text-blue-700 hover:text-blue-900">Ver más <span aria-hidden="true">&rarr;</span></a>
            </div>
            <EventTable limit={5} />
        </section>
        <section class="border-l-4 border-alternative bg-white p-6 shadow-sm">
            <div class="mb-5 flex items-center justify-between gap-4">
                <h2 class="text-2xl font-semibold text-gray-800">Usuarios</h2>
                <a href="/admin/usuarios" class="font-semibold text-blue-700 hover:text-blue-900">Ver más <span aria-hidden="true">&rarr;</span></a>
            </div>
            <UserTable limit={5} currentUserId={Astro.locals.user?.id} />
        </section>
    </div>
</AdminLayout>