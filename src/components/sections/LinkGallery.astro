---
type Props = {
    h1?: string;
    h2?: string;
}

const { h1, h2 } = Astro.props;
---
<section class="w-full h-fit flex flex-col items-center bg-brand-dark p-12 lg:py-24 gap-6">
    <!-- Título y descripción -->
    <div class="flex flex-col text-white gap-6 w-full max-w-160 lg:max-w-400">
        <h1>{h1}</h1>
        <h2>{h2}</h2>
    </div>
    <!-- link cards -->
    <div class="flex flex-col lg:flex-row gap-0.5 lg:max-w-400">
        <slot />
    </div>
</section>