---
import Button from "../ui/Button.astro";
---

<div class="flex flex-col gap-6
            lg:grid lg:grid-cols-3 lg:h-160">

    <!-- card celebraciones -->
    <div
    class="group relative w-full h-100 rounded-[40px] overflow-hidden
            order-1
            lg:col-span-1 lg:row-span-2 lg:h-full">

        <div class="absolute inset-0 bg-[url(/salon_principal.jpg)] bg-cover bg-center
                    transition-transform duration-700 ease-out
                    group-hover:scale-110"></div>
        
        <div class="relative z-10 w-full h-full rounded-[40px] bg-linear-to-t from-black via-black/25 to-black/0
                    flex flex-col
                    gap-6 items-start justify-end
                    p-6 text-white">
            <!-- top -->
            <div>
                <h1>Domingos<br>11:00</h1>
                <h3>¡Eres bienvenido!<br>C/ Casiodoro de Reina, 1</h3>
            </div>
            <!-- bottom -->
            <div >
                <Button bg='ivory' textColor='brand-dark'>
                    ¡Visítanos!
                </Button>
            </div>
        </div>
    </div>

    <!-- card focus -->
    <div
    class=" w-full h-auto rounded-[40px]
            bg-black bg-cover bg-center
            order-4 lg:col-span-1 lg:row-span-1">
        
        <div class="w-full h-full
                    flex flex-col
                    gap-6 items-start justify-between
                    p-6 text-white">
            <!-- top -->
            <div>
                <h1>FOCUS</h1>
                <h3>Adolescentes y Jóvenes</h3>
            </div>
            <!-- bottom -->
            <div >
                <h2>2º y 4º Sábados | 19:00</h2>
            </div>
        </div>
    </div>

    <!-- card ayuda social -->
    <div
    class=" w-full h-auto rounded-[40px]
            bg-ivory bg-cover bg-center
            order-3 lg:order-2 lg:col-span-1 lg:row-span-1">
        
        <div class="w-full h-full
                    flex flex-col
                    gap-6 items-end justify-between
                    p-6 text-brand-dark">
            <!-- top -->
            <div class="text-right">
                <h1>Ayuda Social</h1>
                <h3>Reparto de alimentos y más</h3>
            </div>
            <!-- bottom -->
            <div >
                <h2>Martes | 17:00</h2>
            </div>
        </div>
    </div>

    <!-- card pgm -->
    <div
    class="group relative w-full h-100 rounded-[40px] overflow-hidden
            order-2 lg:order-3 lg:col-span-1 lg:row-span-2 lg:h-full">

        <div class="absolute inset-0 bg-[url(/abrazo.jpg)] bg-cover bg-center
                    transition-transform duration-700 ease-out
                    group-hover:scale-110"></div>
        
        <div class="relative z-10 w-full h-full rounded-[40px] bg-linear-to-t from-black via-black/25 to-black/0
                    flex flex-col
                    gap-6 items-end justify-end
                    p-6 text-white">
            <!-- top -->
            <div class="text-right">
                <h1>Pequeños<br>Grupos<br>Multiplicadores</h1>
                <h3>¡Reuniones de martes a sábado!</h3>
            </div>
            <!-- bottom -->
            <div >
                <Button bg='ivory' textColor='brand-dark'>
                    ¡Encuentra uno!
                </Button>
            </div>
        </div>
    </div>
</div>