---
type Props = {
    imgSrc: string,
    imgAlt?: string,
    bgColor?: string,
    txtColor?: string,
    align?: "left" | "right",
};

const { imgSrc, imgAlt, 
        bgColor = "black", 
        txtColor = "white", 
        align = "left" } = Astro.props;

const textLeft = align === "left";
const customColors = "bg-"+bgColor+" text-"+txtColor;
---
<section class=`w-full flex lg:flex-row flex-col 
                justify-between items-center
                ${customColors} group`>
    <!-- contenido -->
        {!textLeft && (
            <!-- imagen -->
            <img src={imgSrc} alt={imgAlt}
                class="h-80 w-full lg:h-full lg:w-100 lg:aspect-8/11 
                    object-center object-cover 
                    transition-opacity duration-300
                    lg:opacity-80 lg:group-hover:opacity-100"
            >)}

        <!-- texto -->
        <article class="flex flex-col w-full h-fit items-center gap-5 p-16">
            
            <div class="w-full ease-out transition-all duration-200 
            lg:group-hover:-mr-1.5 lg:group-hover:ml-1.5 
            lg:opacity-75 lg:group-hover:opacity-100">
            <slot name="title"/>
        </div>
        
        <div class="w-full lg:opacity-50 lg:group-hover:opacity-100 ease-out transition-opacity duration-500 ">
            <slot name="text"/>
        </div>
        
    </article>

    {textLeft && (
        <!-- imagen -->
        <img src={imgSrc} alt={imgAlt}
            class="h-80 w-full lg:h-full lg:w-100 lg:aspect-8/11 
                object-center object-cover 
                transition-opacity duration-300
                lg:opacity-80 lg:group-hover:opacity-100"
        >)}
</section>