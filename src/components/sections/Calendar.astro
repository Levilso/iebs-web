---
import CalendarEvent from '../events/CalendarEvent.astro'
---
<section class="flex flex-col
        w-full h-fit
        bg-[url(/templo_arriba.jpeg)] bg-cover bg-bottom text-white
        ">
    <div class="flex justify-center
        bg-black/90 hover:bg-black/80 ease-out duration-600 
        w-full h-full 
        p-8 py-20 lg:px-20 lg:py-24">
        <!-- contenido -->
        <div class="
        flex flex-col gap-10 
        w-full max-w-400">

            <!-- encabezado -->
            <div class="flex flex-col gap-4 lg:gap-8 w-full">
                <h1>Calendario IEBS:</h1>
                <h3>¡Guarda las fechas de las próximas actividades de nuestra agenda!</h2>
            </div>
            
            <!-- lista de eventos -->
            <div class="flex flex-col gap-6 w-full">
                <CalendarEvent />
                <CalendarEvent />
                <CalendarEvent />
                <CalendarEvent />
            </div>
        </div>
    </div>
</section>