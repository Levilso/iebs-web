---
type Props = {
    eventId: number;
    capacity: number | null | undefined;
    registered: number; // plazas ya ocupadas. se pasa como prop para evitar accesos innecesarios a la DB
};
const { eventId, capacity, registered } = Astro.props;

const ilimitado = capacity === null || capacity === undefined;
const disponibles = ilimitado ? null : capacity - registered;
const completo = disponibles !== null && disponibles <= 0;
---

<div class="bg-white rounded-xl shadow p-6 mt-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">Inscribirse al evento</h2>

    {completo ? (
        <p class="text-red-600 font-medium">Este evento está completo.</p>
    ) : (
        <div>
            <p class="text-sm text-gray-500 mb-4">
                <strong>{disponibles === null ? 'Plazas ilimitadas' : (disponibles < 10 ? `Solo hay ${disponibles} plaza(s) disponible(s)` : 'Aún quedan plazas disponibles')}</strong>
            </p>

            <div id="reg-feedback" class="hidden mb-4 p-3 rounded text-sm font-medium"></div>

            {/* FORMULARIO DE INSCRIPCIÓN */}
            <form id="reg-form" class="space-y-4">
                <input type="hidden" name="eventId" value={eventId} />

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nombre completo</label>
                    <input type="text" name="name" required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                    <input type="email" name="email" required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Número de personas</label>
                    <input
                        type="number"
                        name="num"
                        min="1"
                        {...(disponibles !== null ? { max: Math.min(disponibles, 10) } : {})}
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500" />
                </div>

                <button type="submit" id="btn-inscribir"
                    class="w-full py-2 px-4 bg-[#0E889E] text-white font-semibold rounded-md hover:bg-[#0a6e80] transition-colors cursor-pointer">
                    Confirmar inscripción
                </button>
            </form>
        </div>
    )}
</div>

<script>
    import { actions } from 'astro:actions';

    const form = document.getElementById('reg-form') as HTMLFormElement | null;
    const feedback = document.getElementById('reg-feedback') as HTMLDivElement;
    const btn = document.getElementById('btn-inscribir') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Procesando...';
        feedback.className = 'hidden mb-4 p-3 rounded text-sm font-medium';

        const { data, error } = await actions.registration.create(new FormData(form));

        feedback.classList.remove('hidden');
        if (error) {
            feedback.classList.add('bg-red-100', 'text-red-700');
            feedback.textContent = error.message;
            btn.disabled = false;
            btn.textContent = 'Confirmar inscripción';
        } else {
            feedback.classList.add('bg-green-100', 'text-green-700');
            feedback.textContent = `✓ ¡Inscripción confirmada! Te esperamos, ${data.registration.name}.`;
            form.reset();
            // Ocultar el formulario tras éxito
            form.classList.add('hidden');

            console.log('Inscripción creada con éxito:', data);
        }
    });
</script>