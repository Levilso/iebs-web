---
const { event } = Astro.props;
import type { EventEntryType } from '../../types.ts';
import TextEditor from '../ui/TextEditor.astro';
type Props = {
    event?: EventEntryType;
};

// definir modo edición o creación
const isEditMode = !!event;
let parseDate = "";
if (isEditMode) {
    parseDate = new Date(event.date).toISOString().split('T')[0];
}

---
<style>
    label {
        font-size: 0.875rem
        line-height: calc(1.25 / 0.875)
        display: block;
        font-weight: 600;
        margin-bottom: 5px;
    }
    input, textarea {
        width: 100%;
        margin-top: 0.25rem;
        padding: 0.5rem;
        border: 1px solid #d1d5dc; /* Tailwind gray-300 */
        border-radius: 4px;
        transition: border-color 0.2s;
        &:focus {
            border-color: oklch(62.3% 0.214 259.815); /* Tailwind blue-500 */
            outline: none; 
            --tw-ring-color: oklch(62.3% 0.214 259.815); /* Tailwind blue-500 */
        }
    }
</style>

<div>
    <h1 class="font-semibold text-black text-4xl p-5 text-center">
        {isEditMode ? 'Editar Evento' : 'Añadir Nuevo Evento'}
    </h1>

    <div id="feedback" class="mb-4 font-medium rounded p-3 hidden"></div>

    <form method="POST"
        class="grid grid-cols-1 justify-center mx-50 space-y-5"
        id="event-form"
        data-edicion={isEditMode.toString()} 
        >

        {isEditMode && <input type="hidden" name="id" value={event.id} />}


        <label for="title">Título del evento:</label>
        <input type="text" id="title" name="title" 
        value={event?.title || ''} required>

        <label for="description">Descripción:</label>
        <textarea id="description" name="description" 
        required>{event?.description || ''}</textarea>

        <!-- textarea completa para el contenido del evento -->
        
        <label for="info" class="block text-sm font-semibold mb-1">
            Información detallada:
        </label>
        <textarea name="info" id="info">{event?.info || ''}</textarea>
        <!-- TODO: <TextEditor
            name="info"
            value={event?.info || ''}
            required
        /> -->

        <label for="date">Fecha:</label>
        <input type="date" id="date" name="date" value={parseDate}
        required>

        <label for="location">Ubicación:</label>
        <input type="text" id="location" name="location" value={event?.location || 'Iglesia Evangélica Bautista de Sevilla'}
        required>

        <label for="price">Precio (€):</label>
        <input type="number" id="price" name="price" step="0.5" value={event?.price || 0}
        required>

        <label for="capacity">Limite de capacidad de personas:</label>
        <input type="number" id="capacity" name="capacity" step="1" value={event?.capacity || ''} placeholder="Dejálo vacío si no hay límite.">

        <div class="inline-flex flex-row">
            <label for="hidden"
            class="w-auto block text-sm text-gray-700">
            Ocultar evento:</label>
            
            <input type="checkbox" name="hidden" id="hidden" checked={event?.hidden} value="true"
            class="text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
        </div>

        {isEditMode && (
            <div id="current-image-container" class="mb-2">
                <p class="text-sm text-grayl-500 mb-1">Imagen de portada actual:</p>
                <img src={event.coverImage} alt="Portada actual" 
                class="w-48 h-32 object-cover rounded-md border"
                />
            </div>
        )}

        <!-- imagen nueva -->
        <div id="image-preview-container" class="hidden">
            <p class="text-sm text-gray-500 mb-1">Nueva imagen:</p>
            <img id="image-preview" src="" alt="Preview" 
            class="w-48 h-32 object-cover rounded-md border"/>
            <p id="upload-status" class="text-xs mt-1"></p>
        </div>

        <input type="file" id="coverImageFile" accept="image/*"
        class="
            w-full mt-1 text-sm text-gray-500
            file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 
            file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
        />

        <!-- input oculto para la URL de la imagen de portada -->
        <input type="hidden" name="coverImage" id="coverImageURL" value={event?.coverImage || ''} />

        <button type="submit" id="btn-guardar"
        class="w-full rounded-md px-4 py-2 bg-blue-400 text-white font-bold hover:bg-blue-700 transition-colors duration-300">
            Guardar Evento</button>

    </form>
</div>

<script> 
    // Manejo del formulario para crear un nuevo evento.
    // Lo que se hace dentro del script se implementa en el cliente, no en el servidor. Es decir, se ejecuta en el navegador del usuario.

    import { actions } from 'astro:actions';

    // ---- SUBIDA DE IMAGEN
    const fileInput = document.getElementById('coverImageFile') as HTMLInputElement;
    const previewContainer = document.getElementById('image-preview-container') as HTMLDivElement;
    const previewImage = document.getElementById('image-preview') as HTMLImageElement;
    const uploadStatus = document.getElementById('upload-status') as HTMLParagraphElement;
    const coverImageURL = document.getElementById('coverImageURL') as HTMLInputElement;

    fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;

        // preview local inmediato antes de subir
        previewImage.src = URL.createObjectURL(file);
        previewContainer.classList.remove('hidden');
        uploadStatus.textContent = 'Subiendo imagen...';
        uploadStatus.className = 'text-xs mt-1 text-gray-400';

        // subida a cloudinary via endpoint
        const data = new FormData();
        data.append('coverImage', file);
        try {
            const response = await fetch('/api/upload-image', {
                method: 'POST',
                body: data,
            });
            const result = await response.json();

            if (!response.ok) throw new Error(result.error || 'Error al subir la imagen');

            coverImageURL.value = result.url; // actualizar el input oculto con la URL de la imagen subida
            console.log('Imagen subida con éxito. URL:', result.url);
            uploadStatus.textContent = '✓ Imagen subida exitosamente';
            uploadStatus.className = 'text-xs mt-1 text-green-600';

        } catch (error) {
            console.error('Error en la subida de imagen:', error);
            uploadStatus.textContent = 'Error al subir la imagen';
            uploadStatus.className = 'text-xs mt-1 text-red-500';
            coverImageURL.value = ''; // limpiar el input oculto en caso de error
        }
    });

    // Elementos del DOM
    const form = document.getElementById('event-form') as HTMLFormElement;
    const feedback = document.getElementById('feedback') as HTMLDivElement;
    const btnGuardar = document.getElementById('btn-guardar') as HTMLButtonElement;


    // ---- SUBMIT
    form?.addEventListener('submit', async (e) => {
        
        e.preventDefault();
        
        const isEditMode = form.dataset.edicion === 'true'; // se accede al atributo data-edicion del form
        
        // BOTÓN
        btnGuardar.disabled = true; // Deshabilitar el botón para evitar múltiples envíos
        btnGuardar.textContent = 'Guardando...'; // Cambiar el texto del botón para indicar que se está procesando
        
        // FEEDBACK
        feedback.classList.add('hidden');
        feedback.textContent = ''; // Limpiar mensajes anteriores
        
        // EJECUTAR ACCIÓN
        const formData = new FormData(form);
        const accion = isEditMode ? actions.event.updateEventEntry : actions.event.createEventEntry;
        console.log(accion);
        const {data, error} = await accion(formData);
        console.log("Respuesta de la acción:", {data, error});
        feedback.classList.remove('hidden');

        if (error) { // error al crear el evento
            feedback.classList.remove('text-green-500');
            feedback.classList.add('text-red-500');
            feedback.textContent = `ERROR: ${error.message}`;

        } else { // éxito al crear el evento
            feedback.classList.remove('text-red-500');
            feedback.classList.add('text-green-500');
            feedback.textContent = `Evento ${data.id} - ${data.title} ${isEditMode ? "actualizado" : "creado"} exitosamente`;
            form.classList.add('hidden'); // Ocultar el formulario tras éxito

            // TO DO: redirigir a la página del evento con un popup

            if (!isEditMode) form.reset(); // Limpiar el formulario para permitir la creación de otro evento
            window.location.reload(); // Recargar la página para mostrar el nuevo evento en la galería
        }

        btnGuardar.disabled = false; // Rehabilitar el botón para permitir reintentos
    });
</script>