---
// AdminNavMenu.astro - Navigation menu component
interface Props {
	items?: Array<{
		href: string;
		label: string;
		icon: string;
	}>;
}

const { items = [] } = Astro.props;

// Default items
const defaultItems = [
	{
		href: '/admin/',
		label: 'Dashboard',
		icon: 'M3 12l2-3m0 0l7-4 7 4M5 9v10a1 1 0 001 1h12a1 1 0 001-1V9m-9 4v4m0-11V5a1 1 0 011-1h2a1 1 0 011 1v2m0 0V5'
	},
	{
		href: '/admin/eventos',
		label: 'Eventos',
		icon: 'M8 7V3m8 4V3M5 11h14M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'
	},
	{
		href: '/admin/usuarios',
		label: 'Usuarios',
		icon: 'M16 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m16 0v-2a4 4 0 00-3-3.87M12 7a4 4 0 11-8 0 4 4 0 018 0zm8 4a4 4 0 00-3-3.87'
	},
];

const navItems = items.length > 0 ? items : defaultItems;
---

<nav class="flex-1 px-3 py-4 overflow-y-auto">
	<div class="space-y-2">
		{navItems.map((item) => (
			<a
				href={item.href}
				class="flex items-center px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors duration-200"
			>
				<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
				</svg>
				<span>{item.label}</span>
			</a>
		))}
	</div>
</nav>