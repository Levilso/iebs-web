---
import Hamburger from '../../assets/svg/burger-menu.svg';
import CloseIcon from '../../assets/svg/close-button.svg';

import Icono from '../../assets/svg/icono.svg';
import Logo from '../../assets/svg/logotipo.svg';

const pathname = Astro.url.pathname;
const section = pathname.split('/').filter(Boolean)[0];

const mainNav = [
    { href: '/jesus',      label: 'Jesús' },
    { href: '/nosotros/',  label: 'Nosotros' },
    { href: '/visitanos',  label: 'Visítanos' },
    { href: '/pgm/',       label: 'PGM' },
    { href: '/recursos',   label: 'Recursos' },
    { href: '/eventos',    label: 'Eventos' },
];
---
<header class="
    w-full flex flex-row items-center justify-between
    p-4 gap-6 lg:px-16">

    <!-- Logo -->
    <a href="/">
    <div class="flex flex-row items-center gap-4">
        <Icono />
        <span class="w-px h-8 bg-brand hidden lg:block"></span>
        <Logo class="hidden lg:block" />
    </div>
    </a>

    <!-- Desktop nav -->
    <nav class="
        hidden lg:flex flex-row 
        justify-center items-center 
        gap-4 text-md text-brand-dark nav-text">
        {mainNav.map(link => (
            <a
                href={link.href}
                class:list={[
                    'transition-opacity duration-150 hover:opacity-75',
                    (pathname === link.href || `/${section}/` === link.href) ? 'border-b-brand-dark border-b-3' : ''
                ]}
            >
                {link.label}
            </a>
        ))}
    </nav>

    <!-- HAMBURGER (mobile only) -->
    <button id="hamburger-btn"
        class="lg:hidden p-2 text-gray-800 flex flex-col gap-1.5 cursor-pointer"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-overlay"
    >
        <!-- <Hamburger /> -->
        <Hamburger />
    </button>
</header>

<!-- OVERLAY (mobile) -->
<div id="mobile-overlay"
    class="fixed inset-0 bg-brand-dark
            flex-col items-end justify-between
            w-screen h-fit hidden
            py-6 px-8 gap-12 z-50"
            aria-hidden="true">

    <!-- top -->
    <div class="flex flex-col items-end justify-between w-full h-auto gap-12">
        <!-- icons -->
        <div class="flex flex-row items-center justify-between w-full h-auto">
            <!-- Logo -->
            <Logo fill="white" width="190" height="36" />

            <!-- Close button -->
            <button id="close-menu-btn"
                class="cursor-pointer"
                aria-label="Cerrar menú"
            >
                <CloseIcon />
            </button>

        </div>

        <!-- menu -->
        <div>
            <!-- Main Nav -->
            <nav class="
                flex flex-col items-end gap-4 text-white nav-text">
                {mainNav.map(link => (
                    <a href={link.href} class="hover:opacity-70 transition-opacity">
                        {link.label}
                    </a>
                ))}
            </nav>
        </div>
    </div>

    <!-- bottom -->
    <div class="w-full flex justify-start">
        <!-- log-in -->
        <button class="bg-white text-brand-dark font-heading cursor-pointer
                        text-xl font-bold 
                        px-4 py-2 rounded-xl">
            Iniciar sesión
        </button>
    </div>
</div>

<script>
    function initNav() {
        
        const hamburgerBtn = document.getElementById('hamburger-btn');
        const closeBtn     = document.getElementById('close-menu-btn');
        const overlay      = document.getElementById('mobile-overlay');

        function openMenu() {
            overlay?.classList.replace('hidden', 'flex');
            overlay?.setAttribute('aria-hidden', 'false');
            hamburgerBtn?.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
            overlay?.classList.replace('flex', 'hidden');
            overlay?.setAttribute('aria-hidden', 'true');
            hamburgerBtn?.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        }

        hamburgerBtn?.addEventListener('click', openMenu);
        closeBtn?.addEventListener('click', closeMenu);
        overlay?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeMenu();
        });
    }
    initNav();
    // Close after navigation (View Transitions)
    document.addEventListener('astro:after-swap', initNav);
</script>