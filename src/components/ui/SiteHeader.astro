---
const pathname = Astro.url.pathname;
const section = pathname.split('/').filter(Boolean)[0];

// Single glob for both SubHeader (desktop) and overlay (mobile)
const modules = import.meta.glob('/src/pages/**/*.astro', { eager: true });

const allItems = Object.entries(modules)
    .filter(([path]) => {
        const parts = path.replace('/src/pages/', '').split('/');
        return (
            parts[0] === section &&
            parts.length === 2 &&
            !parts[1].startsWith('[') &&
            !parts[1].startsWith('_')
        );
    })
    .map(([path, mod]: [string, any]) => {
        const filename = path.split('/').pop()!.replace('.astro', '');
        const isIndex = filename === 'index';
        return {
            href: isIndex ? `/${section}/` : `/${section}/${filename}`,
            label: mod.navTitle as string | undefined,
            isIndex,
        };
    })
    .filter(item => item.label);

const indexItem = allItems.find(item => item.isIndex);
const rest = allItems
    .filter(item => !item.isIndex)
    .sort((a, b) => a.label!.localeCompare(b.label!));
const sectionNavItems = indexItem ? [indexItem, ...rest] : rest;

const mainNavLinks = [
    { href: '/',          label: 'Inicio' },
    { href: '/conocenos', label: 'Conócenos' },
    { href: '/pgm',       label: 'PGM' },
    { href: '/eventos',   label: 'Eventos' },
    { href: '/recursos',  label: 'Recursos' },
    { href: '/jesus',     label: 'Jesús' },
];
---

<!-- ── Top bar ────────────────────────────────────────────────── -->
<header class="w-full flex items-center justify-between py-4 px-4 md:px-16 bg-white drop-shadow-md relative z-50">

    <a href="/" class="font-extrabold text-3xl text-black">IEBS</a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-4 text-sm uppercase text-black">
        {mainNavLinks.map(link => (
            <a
                href={link.href}
                class:list={[
                    'px-2 py-1 transition-colors hover:text-[#0E889E]',
                    pathname === link.href ? 'text-[#0E889E] font-semibold' : ''
                ]}
            >
                {link.label}
            </a>
        ))}
    </nav>

    <!-- Hamburger (mobile only) -->
    <button
        id="hamburger-btn"
        class="md:hidden flex flex-col justify-center gap-1.5 w-8 h-8 cursor-pointer"
        aria-label="Abrir menú"
        aria-expanded="false"
    >
        <span class="block w-6 h-0.5 bg-gray-800 transition-all duration-300 origin-center"></span>
        <span class="block w-6 h-0.5 bg-gray-800 transition-all duration-300"></span>
        <span class="block w-6 h-0.5 bg-gray-800 transition-all duration-300 origin-center"></span>
    </button>
</header>

<!-- ── Desktop SubHeader ─────────────────────────────────────── -->
{sectionNavItems.length > 0 && (
    <nav class="hidden md:block w-full bg-white border-b border-gray-200">
        <div class="max-w-5xl mx-auto px-6 flex gap-6 overflow-x-auto">
            {sectionNavItems.map(({ href, label }) => (
                <a
                    href={href}
                    class:list={[
                        'py-3 text-sm font-medium whitespace-nowrap border-b-2 transition-colors',
                        pathname === href
                            ? 'border-[#0E889E] text-[#0E889E]'
                            : 'border-transparent text-gray-500 hover:text-gray-800'
                    ]}
                >
                    {label}
                </a>
            ))}
        </div>
    </nav>
)}

<!-- ── Mobile overlay ────────────────────────────────────────── -->
<div
    id="mobile-overlay"
    class="fixed inset-0 bg-[#0E889E] z-40 flex flex-col items-center justify-center gap-10
           translate-x-full transition-transform duration-300 ease-in-out md:hidden"
    aria-hidden="true"
>
    <button
        id="close-btn"
        class="absolute top-5 right-5 text-white cursor-pointer p-2"
        aria-label="Cerrar menú"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    <nav class="flex flex-col items-center gap-7 text-white text-xl uppercase font-semibold tracking-wide">
        {mainNavLinks.map(link => (
            <a href={link.href} class="hover:opacity-70 transition-opacity">
                {link.label}
            </a>
        ))}
    </nav>

    {sectionNavItems.length > 0 && (
        <div class="flex flex-col items-center gap-4 border-t border-white/30 pt-8 w-48">
            <p class="text-white/60 text-xs uppercase tracking-widest">Esta sección</p>
            {sectionNavItems.map(item => (
                <a href={item.href} class="text-white text-base hover:opacity-70 transition-opacity">
                    {item.label}
                </a>
            ))}
        </div>
    )}
</div>

<script>
    function initNav() {
        const hamburger = document.getElementById('hamburger-btn');
        const closeBtn  = document.getElementById('close-btn');
        const overlay   = document.getElementById('mobile-overlay');
        const lines     = hamburger?.querySelectorAll('span');

        const open = () => {
            overlay?.classList.remove('translate-x-full');
            overlay?.setAttribute('aria-hidden', 'false');
            hamburger?.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            if (lines) {
                lines[0].style.transform = 'rotate(45deg) translate(2px, 3px)';
                lines[1].style.opacity = '0';
                lines[2].style.transform = 'rotate(-45deg) translate(2px, -3px)';
            }
        };

        const close = () => {
            overlay?.classList.add('translate-x-full');
            overlay?.setAttribute('aria-hidden', 'true');
            hamburger?.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            if (lines) {
                lines[0].style.transform = '';
                lines[1].style.opacity = '';
                lines[2].style.transform = '';
            }
        };

        hamburger?.addEventListener('click', open);
        closeBtn?.addEventListener('click', close);
        overlay?.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    }

    initNav();
    document.addEventListener('astro:after-swap', initNav);
</script>