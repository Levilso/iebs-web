---
import SubHeader from "./SubHeader.astro";

const {background, h1} = Astro.props;
---
<!-- hero-container -->
<div class="w-full h-full lg:h-180
            flex justify-center 
            lg:px-8 lg:py-4
            ">
   
    <!-- hero -->
    <div class="w-full h-120 lg:h-full 
                flex flex-col items-start justify-center
                lg:max-w-[90%] lg:rounded-[40px] overflow-hidden
                bg-[url(/templo_campo.jpeg)] bg-cover bg-position-[-10rem] md:bg-center bg-no-repeat
                ">
        <!-- efectos en el bg -->
        <div id="bg" class="flex w-full h-full lg:p-16 group
                            bg-black/50 lg:bg-transparent lg:bg-linear-to-t lg:from-black to-50% to-gray-700/20
                            max-lg:hover:bg-black/30 lg:hover:pl-18 ease-out duration-700
                            items-center justify-start lg:items-end">
            
            <!-- contenido -->
            <p class="
            flex p-5 w-[30%] lg:w-full
            font-heading font-bold leading-14 
            tracking-tighter text-6xl lg:text-8xl text-white">
                {h1}
            </p>
        </div>

        <SubHeader />

    </div>
</div>